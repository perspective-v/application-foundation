<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Required elements-->
		<PackageId>PerspectiveV.Common</PackageId>
		<Title>Perspective-v Common</Title>
		<Version>10.0.0-alpha.1</Version>
		<Description>Commonly used classes for identity, mailing, app configuration, extension classes and common model classes.</Description>
		<Authors>Hassan Taj</Authors>
		<PackageIcon>pv_vsex_icon.png</PackageIcon>
		<PackageIconUrl></PackageIconUrl>
		<RepositoryUrl>https://github.com/perspective-v/application-foundation</RepositoryUrl>
		<RepositoryType>private</RepositoryType>
		<Owners>Perspective-V</Owners>
		<ApplicationIcon>pv_icon.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Update="pv_vsex_icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Update="pv_icon.ico">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Remove="pv_icon.ico" />
		<None Remove="pv_vsex_icon.png" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="pv_icon.ico">
			<PackagePath></PackagePath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Visible>true</Visible>
			<Pack>true</Pack>
		</EmbeddedResource>
		<EmbeddedResource Include="pv_vsex_icon.png">
			<PackagePath></PackagePath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Visible>true</Visible>
			<Pack>true</Pack>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\PerspectiveV.Primitives\PerspectiveV.Primitives.csproj" />
	</ItemGroup>

</Project>
